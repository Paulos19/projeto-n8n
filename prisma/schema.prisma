// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define o Enum para as roles de usuário
enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  identifier    String?   @unique
  passwordHash  String?
  webhookApiKey String?   @unique
  instanceName  String?
  // CORREÇÃO: Adiciona o campo 'role' sem assumir a existência de createdAt/updatedAt
  role          Role      @default(USER)

  accounts             Account[]
  sessions             Session[]
  sellers              Seller[]
  avaliacoes           Avaliacao[]
  customerReviews      CustomerReview[]
  chatInteractions     ChatInteraction[]
  geminiChatMessages   GeminiChatMessage[]
  chatbotActiveSession ChatbotActiveSession?
  chatbotArchivedChats ChatbotArchivedChat[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Seller {
  id                    String   @id @default(cuid())
  name                  String?
  evolutionInstanceName String
  evolutionApiKey       String
  sellerWhatsAppNumber  String
  isActive              Boolean  @default(true)
  storeOwnerId          String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  storeOwner       User              @relation(fields: [storeOwnerId], references: [id], onDelete: Cascade)
  avaliacoes       Avaliacao[]
  chatInteractions ChatInteraction[]

  @@unique([storeOwnerId, evolutionInstanceName])
  @@unique([storeOwnerId, evolutionApiKey])
  @@unique([storeOwnerId, sellerWhatsAppNumber])
}

model Avaliacao {
  id                  String   @id @default(cuid())
  nota_cliente        Int?
  pontos_fortes       String[]
  pontos_fracos       String[]
  tempo_resposta      String?
  clareza_comunicacao String?
  resolucao_problema  String?
  sugestoes_melhoria  String[]
  resumo_atendimento  String?
  remoteJid           String?
  userId              String?
  sellerId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sellerId])
}

model CustomerReview {
  id           String   @id @default(cuid())
  reviewerName String?
  rating       Int?
  comment      String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatInteraction {
  id                 String   @id @default(cuid())
  remoteJid          String
  messageId          String?  @unique
  customerName       String?
  chatHistory        Json?
  analysisSummary    String?
  analysisKeywords   String[]
  sellerInstanceName String?
  interactionType    String?
  content            String?
  eventTimestamp     DateTime
  source             String?
  status             String?
  metadata           Json?
  userId             String?
  sellerId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  seller Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([remoteJid])
  @@index([eventTimestamp])
  @@index([userId])
  @@index([sellerId])
}

model GeminiChatMessage {
  id         String   @id @default(cuid())
  role       String
  content    String
  isArchived Boolean  @default(false)
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChatbotActiveSession {
  id        String   @id @default(cuid())
  userId    String   @unique
  messages  Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatbotArchivedChat {
  id        String   @id @default(cuid())
  userId    String
  name      String
  messages  Json
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LegalContent {
  id        String   @id @default(cuid())
  pageType  String   @unique
  content   String   @db.Text
  updatedAt DateTime @updatedAt
}
